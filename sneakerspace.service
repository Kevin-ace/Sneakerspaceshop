[Unit]
Description=Gunicorn instance to serve SneakerSpace
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/sneakerspace/backend
Environment="PATH=/var/www/sneakerspace/backend/venv/bin"
Environment="FLASK_APP=run.py"
Environment="FLASK_ENV=production"
Environment="DATABASE_URL=postgresql://sneaker_user:space@localhost/sneakers_db"
Environment="SECRET_KEY=f8a3d7c9e1b4f6a2d8c0e5b7a9f3d1c6e8b2a4f0d7c3e9a1b5f8d2c6a0e4b7"
ExecStart=/var/www/sneakerspace/backend/venv/bin/gunicorn --workers 3 --bind unix:/var/www/sneakerspace/sneakerspace.sock -m 007 run:app

[Install]
WantedBy=multi-user.target
